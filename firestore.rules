rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if true;
    }

    // Public restaurant directory and live status updates
    match /restaurants/{restaurantId} {
      // Allow read so all client-side onSnapshot listeners can receive real-time updates
      allow read: if true;

      // Restriction stricte des écritures sur la collection /restaurants/{restaurantId}
      // Validation obligatoire de l'ID du document, du nom, du slug et des statuts autorisés
      allow create, update: if request.resource.data.id == restaurantId
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.slug is string && request.resource.data.slug.size() > 0
        && request.resource.data.status in ['active', 'suspended', 'pending', 'rejected'];

      // Interdiction formelle de la suppression directe côté client
      allow delete: if false;
    }
  }
}
